# chat-plugins JSON files are auto-generated runtime state (mafia logs,
# sample teams, etc.), not source - same class as databases/*.db*.
/config/chat-plugins/*.json
# server/static holds the built, patched client copied in at deploy time
# (single-tunnel architecture) - build output, not source, same as dist/.
